DATABASE_URL=postgresql://mms:mms@localhost:5432/mms
# Non-pooled connection for prisma migrate; same as DATABASE_URL for local docker,
# the direct (non "-pooler") endpoint when using Neon.
DIRECT_URL=postgresql://mms:mms@localhost:5432/mms
TEST_DATABASE_URL=postgresql://mms:mms@localhost:5432/mms_test
PORT=3001
CORS_ORIGIN=http://localhost:5173
JWT_SECRET=dev-only-secret-0123456789abcdef0123456789abcdef
COOKIE_SAMESITE=lax
UPLOADS_DIR=uploads
UPLOADS_PROVIDER=local
# Production may use vercel-blob instead of ephemeral disk. Server secret only:
# BLOB_READ_WRITE_TOKEN=

# Device secret for POST /api/gps/ingest (fail-closed if unset)
GPS_DEVICE_API_KEY=
