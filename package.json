{
  "name": "mms",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "predev": "pnpm --filter @mms/shared build",
    "dev": "concurrently -n shared,api,web -c yellow,blue,green \"pnpm --filter @mms/shared dev\" \"pnpm --filter @mms/api dev\" \"pnpm --filter @mms/web dev\"",
    "build": "pnpm -r build",
    "test": "pnpm -r --if-present test",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck",
    "db:up": "docker compose up -d",
    "db:migrate": "pnpm --filter @mms/api db:migrate",
    "db:seed": "pnpm --filter @mms/api db:seed"
  },
  "devDependencies": {
    "concurrently": "^10.0.3",
    "prettier": "^3.6.2",
    "prettier-plugin-tailwindcss": "^0.7.1"
  }
}
